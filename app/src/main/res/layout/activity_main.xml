<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- ============ TOP BAR ============ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/titleBlock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnSaved"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.04"
                    android:text="CAMPUS"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.04"
                    android:text="CONNECT"
                    android:textColor="@color/accent_teal"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="BMS College of Engineering"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaved"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:contentDescription="View saved events"
            app:icon="@drawable/ic_heart_outline"
            app:iconSize="22dp"
            app:iconTint="@color/text_primary"
            app:rippleColor="#33FFFFFF"
            app:layout_constraintEnd_toStartOf="@id/btnLogout"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="Logout"
            android:textAllCaps="false"
            android:textColor="@color/bg_dark"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/accent_teal"
            app:cornerRadius="10dp"
            app:elevation="0dp"
            app:rippleColor="#33000000"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ============ CUSTOM TABS (horizontally scrollable) ============ -->
    <HorizontalScrollView
        android:id="@+id/tabScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:overScrollMode="never"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:id="@+id/tabRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- POSTERBOARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tabPosterboard"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:checkable="true"
                android:checked="true"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/tab_card_bg_color"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:checkedIcon="@null"
                app:rippleColor="@color/accent_teal_dim"
                app:strokeColor="@color/tab_card_stroke_color"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Posterboard icon"
                        android:src="@drawable/ic_grid"
                        app:tint="@color/tab_text_color" />

                    <TextView
                        android:id="@+id/tvTabPosterboard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:letterSpacing="0.05"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="POSTERBOARD"
                        android:textColor="@color/tab_text_color"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- OPPORTUNITIES -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tabOpportunities"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:layout_marginStart="12dp"
                android:checkable="true"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/tab_card_bg_color"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:checkedIcon="@null"
                app:rippleColor="@color/accent_teal_dim"
                app:strokeColor="@color/tab_card_stroke_color"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Opportunities icon"
                        android:src="@drawable/ic_briefcase"
                        app:tint="@color/tab_text_color" />

                    <TextView
                        android:id="@+id/tvTabOpportunities"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:letterSpacing="0.05"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="OPPORTUNITIES"
                        android:textColor="@color/tab_text_color"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ADMIN (hidden until admin confirmed in code) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tabAdmin"
                android:layout_width="wrap_content"
                android:layout_height="54dp"
                android:layout_marginStart="12dp"
                android:checkable="true"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                app:cardBackgroundColor="@color/tab_card_bg_color"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:checkedIcon="@null"
                app:rippleColor="@color/accent_teal_dim"
                app:strokeColor="@color/tab_card_stroke_color"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Admin icon"
                        android:src="@drawable/ic_dashboard"
                        app:tint="@color/tab_text_color" />

                    <TextView
                        android:id="@+id/tvTabAdmin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:letterSpacing="0.05"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="ADMIN"
                        android:textColor="@color/tab_text_color"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- ============ SEARCH BAR ============ -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilSearch"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="12dp"
        android:hint="Search events, clubs, venues…"
        android:textColorHint="@color/text_secondary"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="@color/accent_teal"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="2dp"
        app:hintTextColor="@color/accent_teal"
        app:startIconDrawable="@drawable/ic_search"
        app:startIconTint="@color/text_secondary"
        app:endIconMode="clear_text"
        app:endIconTint="@color/text_secondary"
        app:layout_constraintTop_toBottomOf="@id/tabScroll">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- ============ CATEGORY FILTER CHIPS ============ -->
    <HorizontalScrollView
        android:id="@+id/chipScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/tilSearch">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="All" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTechnical"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Technical" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCultural"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cultural" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPlacements"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Placements" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- ============ FEED (wrapped for pull-to-refresh) ============ -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/chipScroll"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEvents"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="120dp"
            tools:listitem="@layout/item_event" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- ============ SHIMMER (loading skeleton) ============ -->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/chipScroll"
        app:layout_constraintBottom_toBottomOf="parent"
        app:shimmer_auto_start="false"
        app:shimmer_base_alpha="0.85"
        app:shimmer_highlight_alpha="0.35"
        app:shimmer_duration="1100">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <include layout="@layout/item_event_shimmer" />
            <include layout="@layout/item_event_shimmer" />
            <include layout="@layout/item_event_shimmer" />
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

    <!-- ============ ADMIN DASHBOARD PANEL ============ -->
    <!-- Anchored to tabScroll (chips are hidden on the admin tab via code) -->
    <include
        android:id="@+id/adminPanel"
        layout="@layout/layout_admin_dashboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tabScroll"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- ============ EMPTY STATE ============ -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nothing here yet"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/chipScroll"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ============ EXTENDED FAB ============ -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddEvent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:contentDescription="Add new event"
        android:letterSpacing="0.02"
        android:text="Add Event"
        android:textAllCaps="false"
        android:textColor="@color/bg_dark"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:backgroundTint="@color/accent_teal"
        app:elevation="6dp"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/bg_dark"
        app:rippleColor="#33000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>